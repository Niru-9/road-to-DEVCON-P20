# ---------------------------------------------------------------------------
# Community People Finder - local configuration template (P2).
#
# Copy this file to `.env` and fill in your own values:
#     Copy-Item .env.example .env          (bash/mac: cp .env.example .env)
#
# `.env` is git-ignored and must never be committed. This file is tracked and must
# only ever contain placeholders like the ones below.
#
# Nothing in this file is a real credential.
#
# There is deliberately NO signing-key entry here, and there must never be one.
# ENS profile records are published by signing with the user's MetaMask wallet in
# the browser. This app never asks for, accepts, stores or transmits a private key
# or seed phrase, so there is nothing to put here.
#
# The two secrets below are ordinary API credentials, not wallet keys:
#   LLM_API_KEY      - a model-provider key, used server-side only
#   SEPOLIA_RPC_URL  - only a secret if you use a keyed/Pro RPC endpoint
# ---------------------------------------------------------------------------

# --- Model provider (any OpenAI-compatible API) -----------------------------
# The endpoint and the model id are read from configuration, never hardcoded at the
# call site. Swap these three values to change provider without touching code.
# Examples:
#   Groq       LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter LLM_BASE_URL=https://openrouter.ai/api/v1
#   Gemini     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama     LLM_BASE_URL=http://localhost:11434/v1   (no key needed)
LLM_BASE_URL=https://your-provider.example/v1

# Your provider's API key. Treat it as a secret: it stays server-side and is never
# sent to the browser, never printed, never committed.
LLM_API_KEY=replace-with-your-own-key

# Any model id your provider serves. Provider-specific, e.g. an OpenRouter model
# ending in `:free` for a free tier.
LLM_MODEL=replace-with-a-model-id

# Explicit timeout in milliseconds for every model request. Required: the model
# call is always bounded, so a hung free-tier request can never hang the app.
LLM_TIMEOUT_MS=20000

# Explicit bound on the ANSWER, in tokens. The input is already bounded by
# TOP_K_CANDIDATES; this bounds the output so the cost of a question is known on both
# sides. A name plus a one-line reason per match needs far fewer than 600 tokens.
#
# Raise the timeout above if you run a local model on CPU (Ollama on a laptop can be
# slower than 2 tokens/second), and lower this so a runaway generation still stops.
LLM_MAX_TOKENS=600

# --- Sepolia RPC ------------------------------------------------------------
# Community profiles are read from ENS text records on Sepolia through viem's
# Universal Resolver. A *public* endpoint is fine and is not a secret. A keyed/Pro
# RPC URL IS a secret - keep it in `.env` and never commit it.
#
# This credential is NOT a signing key. It grants read access to a node and cannot
# sign anything. Publishing is signed by MetaMask in the browser, which uses the
# wallet's own RPC - this value is only used by the server for reads.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Explicit bound on every RPC call, so a hanging node cannot hang a request.
RPC_TIMEOUT_MS=15000

# --- Community discovery ----------------------------------------------------
# The community ROOT name. Its `com.peoplefinder.members` text record holds the
# roster, so membership itself is discovered from a live ENS read rather than from
# a list baked into the code. See docs/profile-format.md.
COMMUNITY_ROOT=replace-with-your-community-root-name.eth

# FALLBACK roster, used only when the root name has no roster record published yet
# (the expected state before the demo community is seeded). Comma separated.
# Responses say which one was used: rosterSource "ens-record" or "configured".
# Leave empty to see the "roster not published yet" state instead.
COMMUNITY_MEMBERS=

# Hard ceiling on how many members one refresh will read, so a poisoned or
# accidentally huge roster cannot turn into hundreds of RPC calls.
COMMUNITY_MEMBERS_MAX=12

# --- Retrieval --------------------------------------------------------------
# The explicit top-k bound. This is the scored criterion-2 limit: at most this many
# candidate profiles can ever enter the prompt, whatever the index size.
TOP_K_CANDIDATES=5

# Candidates scoring below this are not retrieved at all. Raising it makes
# retrieval stricter (fewer, more relevant people); lowering it risks padding the
# answer with weak matches.
MIN_CANDIDATE_SCORE=1

# --- Server -----------------------------------------------------------------
PORT=8788

# Simulated community index.
#
# The live ENS path is always attempted first on every refresh. When the live roster
# yields no readable members - which is the true state until the Sepolia demo
# community is published - this flag allows a clearly-labelled SIMULATED index so the
# UI, retrieval and grounding code can be reviewed end to end. Simulated entries are
# marked `source: "simulated"` in every API response and shown with a banner in the UI.
# Set to false to make live ENS data the only possible source.
ALLOW_SIMULATED_INDEX=true